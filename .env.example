# --- LLM / ASR providers (all free tier) ---
GROQ_API_KEY=            # console.groq.com -> API Keys
GOOGLE_API_KEY=          # aistudio.google.com -> Get API key
HF_TOKEN=                # huggingface.co/settings/tokens (needed for pyannote)

# --- Database ---
# Local dev (docker compose):
DATABASE_URL=postgresql://civiclens:civiclens@localhost:5433/civiclens
# Production: replace with your Supabase connection string (Settings -> Database)

# --- Observability (Week 8, leave blank until then) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Models ---
WHISPER_MODEL=whisper-large-v3-turbo     # Groq model id
LLM_MODEL=llama-3.3-70b-versatile        # Groq model id
ROUTER_MODEL=gemini-2.0-flash            # Gemini free tier
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # runs locally, 384 dims
